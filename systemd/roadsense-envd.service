[Unit]
Description=roadsense envd (scene / weather / light analyser, 1 fps)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

[Service]
Type=simple
# Phase 1: root, like the other daemons (the ring lives in /dev/shm, see the camerad unit).
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/shm/roadsense-frames ] && exit 0; sleep 1; done; exit 0'
# One frame per second on the little cores (ONNX Runtime, 2 threads); frames are skipped while the
# hottest zone is above 92 C. Numbers: docs/lanes/L2-envd.md.
ExecStart=/usr/local/bin/envd --backend ort --threads 2 --cpus 0-3 --max-hz 1 --stats 60
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=roadsense.target
