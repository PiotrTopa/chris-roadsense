[Unit]
Description=roadsense envd (scene / weather / light analyser, 1 fps)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

[Service]
Type=simple
# Phase 1: root, like the other daemons (the ring lives in /dev/shm, see the camerad unit).
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/shm/roadsense-frames ] && exit 0; sleep 1; done; exit 0'
# One frame per second on the big cores (ONNX Runtime, 2 threads): 320-345 ms per frame next to modeld
# and signd at no cost to their rates (the little cores take 810 ms); frames are skipped while the
# hottest zone is above 92 C. ncnn/Vulkan hung the GPU (kernel hangcheck), do not use it.
# Numbers: docs/lanes/L2-envd.md (laptop), docs/lanes/L3-speed.md (phone).
ExecStart=/usr/local/bin/envd --backend ort --threads 2 --cpus 4-7 --max-hz 1 --stats 60
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=roadsense.target
