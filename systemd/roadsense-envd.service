[Unit]
Description=roadsense envd (scene / weather / light analyser, 1 fps)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

[Service]
Type=simple
Slice=roadsense.slice
# Phase 1: root, like the other daemons (the ring lives in /dev/shm, see the camerad unit).
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/shm/roadsense-frames ] && exit 0; sleep 1; done; exit 0'
# One frame per second on the little cores (ONNX Runtime, 3 threads): 0.68 s per frame next to the rest of
# the stack, still 1 Hz. On the big cores (2 threads, 0.33 s per frame, the setting until lane L21) the same
# work took 61 % of a big core, 1.25 W of the phone's 6.7 W and 15 C on the big-core sensors; here it costs
# 0.5 W less at the rail, and the road latency drops by 10 ms because the big cores are less contended.
# Under heat the load governor slows envd to one frame in 5 s, then pauses it (<rundir>/governor, env_hz).
# ncnn/Vulkan hung the GPU (kernel hangcheck), do
# not use it. Numbers: docs/lanes/L21-budget-and-models.md; encoder: docs/lanes/L2-envd.md.
ExecStart=/usr/local/bin/envd --backend ort --threads 3 --cpus 0-3 --max-hz 1 --stats 60
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=roadsense.target
