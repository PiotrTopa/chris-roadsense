[Unit]
Description=roadsense perception stack (camerad, modeld, envd, mapd, api; optional sign provider, e.g. roadsense-signd from roadsense-signs)
Wants=roadsense-camerad.service roadsense-modeld.service roadsense-envd.service roadsense-mapd.service roadsense-api.service

[Install]
WantedBy=multi-user.target
