[Unit]
Description=pocopilot modeld (openpilot supercombo road model)
PartOf=pocopilot.target
After=pocopilot-camerad.service
Wants=pocopilot-camerad.service

[Service]
Type=simple
# Phase 1: root. The frame ring lives in /dev/shm and logind would remove a
# normal user's shm segments at logout (RemoveIPC); a system user comes later.
Environment=POCOPILOT_RUNDIR=/run/pocopilot
Environment=POCOPILOT_CONFIG_DIR=/etc/pocopilot
RuntimeDirectory=pocopilot
RuntimeDirectoryPreserve=yes
StateDirectory=pocopilot
ExecStart=/usr/local/bin/modeld --model /var/lib/pocopilot/models/supercombo-fp32.onnx --cpus 4-7 --prep-cpus 0-3 --max-hz 5 --throttle-temp 75000 --stats 10
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=pocopilot.target
