[Unit]
Description=roadsense API (HTTP/WebSocket/MJPEG fan-out over the daemon sockets)
After=network.target roadsense-camerad.service
PartOf=roadsense.target

[Service]
Type=simple
Slice=roadsense.slice
# TODO: dedicated roadsense user once it exists
# User=root for now (reads the root-owned sockets/ring; see the daemon units)
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_DATADIR=/var/lib/roadsense
Environment=PYTHONPATH=/usr/local/lib/roadsense/api
# Port: 8080 by default; a host that already serves 8080 (the Prius car computer
# backend does) sets ROADSENSE_API_PORT in /etc/roadsense/api.env
# (scripts/install-phone.sh API_PORT=8090 writes it).
Environment=ROADSENSE_API_PORT=8080
# Bind address: all interfaces by default; a host controller that fronts the
# API itself (the Prius car computer re-publishes it under /api/v1/roadsense)
# sets ROADSENSE_API_HOST=127.0.0.1 (scripts/install-phone.sh API_HOST=...).
Environment=ROADSENSE_API_HOST=0.0.0.0
EnvironmentFile=-/etc/roadsense/api.env
ExecStart=/usr/bin/python3 -m roadsense_api --host ${ROADSENSE_API_HOST} --port ${ROADSENSE_API_PORT}
Restart=always
RestartSec=2

[Install]
WantedBy=roadsense.target
