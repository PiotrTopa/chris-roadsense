[Unit]
Description=roadsense debug face (raw topics, /preview, load governor; the consumer API is chris-integrator)
After=network.target roadsense-camerad.service
PartOf=roadsense.target

[Service]
Type=simple
Slice=roadsense.slice
# TODO: dedicated roadsense user once it exists
# User=root for now (reads the root-owned sockets/ring; see the daemon units)
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_DATADIR=/var/lib/roadsense
Environment=PYTHONPATH=/usr/local/lib/roadsense/api
# Port: 8091 by default (8090 is the consolidated API of chris-integrator, which forwards /preview,
# /v2/frame.jpg and /v2/governor to this face); /etc/roadsense/api.env overrides
# (scripts/install-phone.sh API_PORT=N writes it).
Environment=ROADSENSE_API_PORT=8091
# Bind address: loopback by default: consumers talk to chris-integrator; set ROADSENSE_API_HOST=0.0.0.0
# (scripts/install-phone.sh API_HOST=...) to look at one camera's raw perception from another machine.
Environment=ROADSENSE_API_HOST=127.0.0.1
EnvironmentFile=-/etc/roadsense/api.env
ExecStart=/usr/bin/python3 -m roadsense_api --host ${ROADSENSE_API_HOST} --port ${ROADSENSE_API_PORT}
Restart=always
RestartSec=2

[Install]
WantedBy=roadsense.target
