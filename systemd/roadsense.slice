[Unit]
Description=roadsense perception stack resource group
# All roadsense units (and a sign provider's unit) run in this slice so that the
# machine's other work stays responsive while the stack saturates the GPU and
# the big cores. The reference deployment shares the phone with the Prius car
# computer backend, which runs at CPUWeight=1000 outside this slice.
Documentation=https://github.com/PiotrTopa/chris-roadsense/blob/main/docs/ARCHITECTURE.md

[Slice]
# cgroup v2 weights only matter under contention: with the host idle the stack
# still gets every core it asks for.
CPUWeight=100
IOWeight=100
# No memory throttling: the stack may use what it needs (the earlier 3 GiB
# MemoryHigh / 3.5 GiB MemoryMax cap was too tight). MemoryMax is only an OOM
# backstop on the 5.5 GiB reference phone, leaving ~1 GiB to the host; the host
# protects its own application (the Prius backend: MemoryLow/MemoryMax in its
# unit) and may restrict the cores with a drop-in (AllowedCPUs).
MemoryMax=4608M
TasksMax=512
