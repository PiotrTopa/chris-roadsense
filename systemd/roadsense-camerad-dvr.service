[Unit]
Description=roadsense camerad-dvr (USB DVR camera 1902:3241 -> frame ring)
# Alternative to roadsense-camerad.service: same ring, same camerad.sock, same preview.jpg.
# scripts/install-camerad-dvr.sh --enable masks roadsense-camerad.service and enables this unit.
Conflicts=roadsense-camerad.service
PartOf=roadsense.target

[Service]
Type=simple
Slice=roadsense.slice
# root: raw block-device reads (read-only, O_EXCL) and the /dev/shm ring (see camerad unit).
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
# --auto waits (1 s retries) for the camera to appear and survives unplug/replug.
ExecStart=/usr/local/bin/camerad-dvr --auto
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=roadsense.target
