[Unit]
Description=roadsense camerad-replay (recorded ride, MJPEG file -> frame ring, looping)
# Alternative to roadsense-camerad.service / roadsense-camerad-dvr.service: same ring, same camerad.sock,
# same preview.jpg. scripts/use-replay.sh --enable FILE switches to it, --disable switches back.
Conflicts=roadsense-camerad.service roadsense-camerad-dvr.service
PartOf=roadsense.target

[Service]
Type=simple
# root: the /dev/shm ring must not belong to a logind user (see camerad unit / ARCHITECTURE.md).
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
# REPLAY_FILE=/path/ride.mjpeg (written by scripts/use-replay.sh --enable FILE); REPLAY_ARGS optional.
EnvironmentFile=/etc/roadsense/camera-replay.env
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
ExecStart=/usr/local/bin/camerad-replay --file ${REPLAY_FILE} $REPLAY_ARGS
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=roadsense.target
