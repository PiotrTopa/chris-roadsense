[Unit]
Description=roadsense modeld (openpilot supercombo road model)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

[Service]
Type=simple
# Phase 1: root. The frame ring lives in /dev/shm and logind would remove a
# normal user's shm segments at logout (RemoveIPC); a system user comes later.
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
# Cap the gold cluster (cpu4-7) at 2.09 GHz: ~0.65x energy per inference for ~1.27x latency
# (68 ms cold), which keeps the SoC off its 95 C thermal limiter. Restored on stop.
ExecStartPre=-/bin/sh -c 'for c in 4 5 6 7; do echo 2092800 > /sys/devices/system/cpu/cpu$c/cpufreq/scaling_max_freq; done'
ExecStopPost=-/bin/sh -c 'for c in 4 5 6 7; do cat /sys/devices/system/cpu/cpu$c/cpufreq/cpuinfo_max_freq > /sys/devices/system/cpu/cpu$c/cpufreq/scaling_max_freq; done'
# GPU backend (ncnn/Vulkan, needs a build with -DROADSENSE_NCNN=ON). Accuracy vs ORT fp32 over a 119-run
# replay: lane y mean 0.018 m, max 0.10 m within 100 m; leads within 0.8 m (p95). See docs/ROADMAP.md.
ExecStart=/usr/local/bin/modeld --backend ncnn --cpus 0-3 --prep-cpus 4-7 --max-hz 20 --throttle-temp 80000 --stats 10
# CPU fallback (ONNX Runtime fp32, exact but ~5 Hz and 90 C on this phone):
# ExecStart=/usr/local/bin/modeld --backend ort --model /var/lib/roadsense/models/supercombo-fp32.onnx --cpus 4-7 --prep-cpus 0-3 --max-hz 5 --throttle-temp 75000 --stats 10
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=roadsense.target
