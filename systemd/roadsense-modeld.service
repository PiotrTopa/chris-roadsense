[Unit]
Description=roadsense modeld (road model: openpilot v0.11.1 vision + policy; supercombo selectable)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

[Service]
Type=simple
Slice=roadsense.slice
# Phase 1: root. The frame ring lives in /dev/shm and logind would remove a
# normal user's shm segments at logout (RemoveIPC); a system user comes later.
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
# Speed first (user ruling 2026-10-26: the fan holds the stack near 60 C on the bench; lane stop 95 C).
# Pin every clock the stack depends on at its top step so nothing ramps down between runs: the
# Adreno's devfreq floor (710 MHz), the silver cluster (cpu0-3: frame prep) and the gold cluster
# (cpu4-7: model thread + ncnn's CPU layers, signd, envd; also uncapped, the old 2.09 GHz cap is gone).
# Measured (docs/lanes/L3-speed.md): 9.6 -> 13.1 road/s with signd at 5 Hz and envd at 1 Hz. Restored on stop.
ExecStartPre=-/bin/sh -c 'for c in 4 5 6 7; do f=/sys/devices/system/cpu/cpu$c/cpufreq; cat $f/cpuinfo_max_freq > $f/scaling_max_freq; cat $f/cpuinfo_max_freq > $f/scaling_min_freq; done'
ExecStartPre=-/bin/sh -c 'for c in 0 1 2 3; do cat /sys/devices/system/cpu/cpu$c/cpufreq/cpuinfo_max_freq > /sys/devices/system/cpu/cpu$c/cpufreq/scaling_min_freq; done'
ExecStartPre=-/bin/sh -c 'cat /sys/class/devfreq/5000000.gpu/max_freq > /sys/class/devfreq/5000000.gpu/min_freq'
ExecStopPost=-/bin/sh -c 'for c in 0 1 2 3 4 5 6 7; do cat /sys/devices/system/cpu/cpu$c/cpufreq/cpuinfo_min_freq > /sys/devices/system/cpu/cpu$c/cpufreq/scaling_min_freq; done'
ExecStopPost=-/bin/sh -c 'cut -d" " -f1 /sys/class/devfreq/5000000.gpu/available_frequencies > /sys/class/devfreq/5000000.gpu/min_freq'
# GPU backend (ncnn/Vulkan, needs a build with -DROADSENSE_NCNN=ON). Accuracy vs ORT fp32 over a 119-run
# replay: lane y mean 0.018 m, max 0.10 m within 100 m; leads within 0.8 m (p95). See docs/ROADMAP.md.
# Model thread on the gold cores (model_ms 83 -> 78 vs the silver cores; signd and envd share them),
# frame prep on the silver cores. No thermal guard here: the load governor (api, docs/ARCHITECTURE.md "Load
# governor") lowers the run rate through <rundir>/governor, and only after everything else has been shed.
# GPU turn-taking with signd (docs/ARCHITECTURE.md "GPU schedule", docs/lanes/L4-gpu-sched.md): runs are
# pipelined (the next run's vision stage is recorded during the current run and submitted the moment it
# ends; default on), signd's detector gets the GPU between two runs on request (--gpu-yield, at most 80 ms;
# the next run starts 2 ms before the detector is expected to end), and a 0 us CPU wake-up latency request
# keeps the cores out of their deep idle state between GPU submits. Replay ride, 2026-10-27: road 13.0 ->
# 14.05 runs/s (15 min), model p90 107 -> 55 ms, road latency p90 168 -> 126 ms, signs 5.0/s.
# Without signd (or with an older one) the schedule file is simply unused.
#
# Road model (lane L27): the command line names none on purpose. modeld's default is the openpilot v0.11.1 line:
# driving_vision on the GPU (driving_vision-ncnn.param/.bin) and driving_policy on the CPU for the plan
# (driving_policy-fp32.onnx, ONNX Runtime, on the model thread; at most 5 runs a second, the plan held in between
# and marked). supercombo v0.9.7 stays selectable: `"road_model": "supercombo"` in /etc/roadsense/modeld.json (or
# --road-model supercombo here). Mixed installations fail safe:
#   new modeld, this unit, vision files missing  -> modeld runs supercombo and says so (`road_model_fallback` in
#       every road line, `road_model.fallback` in /v2/health); with no model file at all it exits with the reason
#   older modeld (supercombo only), this unit    -> no flag here that it does not know: it runs supercombo as before
#   new modeld, an older unit                    -> the same command line as this one: as the first two rows
#   "road_model" set in modeld.json              -> strict: a missing file is an error (exit 1, systemd retries,
#       /v2/health shows modeld without messages), never a silent other model
ExecStart=/usr/local/bin/modeld --backend ncnn --cpus 4-7 --prep-cpus 0-3 --max-hz 20 --gpu-yield 80 --gpu-lead 2 --cpu-latency-us 0 --stats 10
# CPU fallback (ONNX Runtime fp32, exact but ~5 Hz and 90 C on this phone):
# ExecStart=/usr/local/bin/modeld --backend ort --cpus 4-7 --prep-cpus 0-3 --max-hz 5 --stats 10
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=roadsense.target
