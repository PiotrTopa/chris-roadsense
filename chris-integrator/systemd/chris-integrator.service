[Unit]
Description=chris-integrator (the mixer: fusion, object layer, map box, trackers and decisions, consolidated API)
After=network.target
# Part of roadsense.target (scripts/install.sh, docs/INSTALL.md): the target pulls this unit in through its
# .wants/ link ([Install] below), and stopping or restarting the target stops or restarts this unit too.
# It is not enabled at boot by itself.
PartOf=roadsense.target
# A restart loop never gives up (e.g. while another process still holds the port during a switch-over).
StartLimitIntervalSec=0

[Service]
Type=simple
Slice=roadsense.slice
Environment=CHRIS_RUNDIR=/run/chris
Environment=CHRIS_DATADIR=/var/lib/chris
Environment=CHRIS_CONFIG_DIR=/etc/chris
# the chris-roadsense instance whose sockets are read, and its debug face (for /preview, /v2/frame.jpg, /v2/governor)
Environment=CHRIS_ROADSENSE_RUNDIR=/run/roadsense
Environment=CHRIS_ROADSENSE_HTTP=http://127.0.0.1:8091
# the consolidated API (HTTP + WebSocket): what consumers connect to. Loopback by default: a host that wants
# it on the network sets CHRIS_API_HOST in /etc/chris/integrator.env (install.sh API_HOST=...).
Environment=CHRIS_API_HOST=127.0.0.1
Environment=CHRIS_API_PORT=8090
# the map pack of the map box (chris-mapper); a changed pack is loaded without a restart
Environment=CHRIS_MAP_PACK=/var/lib/chris/maps/current.rsmap
Environment=PYTHONPATH=/usr/local/lib/chris
EnvironmentFile=-/etc/chris/integrator.env
RuntimeDirectory=chris
RuntimeDirectoryPreserve=yes
StateDirectory=chris
ExecStart=/usr/bin/python3 -m chris_integrator --roadsense ${CHRIS_ROADSENSE_RUNDIR}
Restart=always
RestartSec=2
# The integrator is in the measurement path (it produces `lead` for every camera frame): a little ahead of
# the background analysers that share its cores (nice 5 there), behind the camera pipeline's own threads
# (nice -5). Within one slice without the cpu controller, nice is what orders the slice's services against
# each other; a CPUWeight= here would switch the controller on and re-weight every sibling. CPU placement is
# per host: install.sh CPUS=... writes a drop-in with CPUAffinity=.
Nice=-2
# A backstop against a leak, not a throttle: no MemoryHigh. About 120 MB resident with the map box on a
# 15 minute replay (docs/INSTALL.md); no watchdog and no start timeout that a hot, throttled CPU could trip.
MemoryMax=768M

[Install]
WantedBy=roadsense.target
